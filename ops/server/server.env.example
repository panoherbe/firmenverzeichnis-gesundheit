# Server configuration for ops/server/provision.sh + bootstrap.sh.
# Copy on the operator's workstation to the repo root as `.env.primary` and `.env.standby` (both gitignored via `.env.*`), fill in,
# then:  ops/server/provision.sh primary root@<primary-ip>   /   ops/server/provision.sh standby root@<standby-ip>
# The file becomes /srv/firmen/app/.env on the server (mode 0600, owner firmen). Never commit filled copies.

# ---- identity
# primary | standby
ROLE=primary
# public name of the directory (A record -> floating IP or primary)
DOMAIN=verzeichnis.example.de
# status page, A record -> STANDBY's own IP (never the floating IP)
STATUS_DOMAIN=status.example.de
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=CHANGE_ME@example.de
PUBLIC_BASE_URL=https://verzeichnis.example.de
# /status on the app redirects here when no local status files
STATUS_URL=https://status.example.de/
# origins allowed to embed the directory (CSP frame-ancestors)
FRAME_ANCESTORS='self' https://www.example.org

# ---- database (local Postgres 16 from Ubuntu; bootstrap creates role + DB with this password)
# `openssl rand -hex 24`
PGPASSWORD_FIRMEN=CHANGE_ME
DATABASE_URL=postgresql://firmen:CHANGE_ME@127.0.0.1:5432/firmen
RAW_DIR=/srv/firmen/raw
BACKUP_DIR=/srv/firmen/backup
BACKUP_RETENTION_DAYS=30

# ---- app
# `openssl rand -hex 32`; same value on primary and standby
SECRET_KEY=CHANGE_ME
MAX_USERS=8
# `openssl rand -hex 16`; same on both (monitor sends it)
OPS_HEALTH_TOKEN=CHANGE_ME
SUPPORT_RETENTION_DAYS=90
ACCESS_LOG_DAYS=90

# ---- e-mail for ticket acknowledgements (optional; without it the ticket number is shown on screen only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# optional: copy of every new ticket to this mailbox
SUPPORT_NOTIFY_TO=

# ---- alerts to the operator's phone (at least one channel; see ops/alert.py)
NTFY_URL=https://ntfy.sh
# long random topic, e.g. firmen-$(openssl rand -hex 12)
NTFY_TOPIC=
NTFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# e.g. "primary-fsn1" / "standby-nbg1"
ALERT_HOST_LABEL=

# ---- standby only: monitor + backup pull
MONITOR_BASE_URL=https://verzeichnis.example.de
MONITOR_SEARCH_PATH=/?q=pharma
MONITOR_SEARCH_MARKER=/firma/
STATUS_DIR=/srv/firmen/app/var/status
# optional dead-man's switch (external service, needs the operator's OK)
HEARTBEAT_URL=
PRIMARY_BACKUP_SRC=firmen@PRIMARY_IP:/srv/firmen/backup/
OFFSITE_DEST=uXXXXXX@uXXXXXX.your-storagebox.de:firmen-backup/
OFFSITE_SSH_PORT=23

# ---- primary only: who watches the monitor
MONITOR_STATUS_URL=https://status.example.de/status.json

# ---- network / failover
# Hetzner Floating IPv4 of DOMAIN (configured on BOTH servers)
FLOATING_IP=
# floating_ip | dns
FAILOVER_METHOD=floating_ip
# standby only: Hetzner Cloud API token (read+write), for failover
HCLOUD_TOKEN=
FLOATING_IP_ID=
# Hetzner Cloud server id of THIS server
THIS_SERVER_ID=
# optional: restrict SSH (ufw) to this network, e.g. your fixed IP/32
ADMIN_SSH_CIDR=
# the other server's IP (allowed to SSH for the backup pull)
PEER_IP=
# unattended-upgrades reboot time; use 05:20 on the standby
REBOOT_TIME=04:40

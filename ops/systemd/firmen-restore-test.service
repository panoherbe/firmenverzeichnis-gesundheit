[Unit]
Description=Firmenverzeichnis weekly restore test into scratch DB (PRIMARY)
OnFailure=firmen-alert@%n.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=firmen
Group=firmen
WorkingDirectory=/srv/firmen/app
ExecStart=/srv/firmen/app/ops/restore_test.sh scratch
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/firmen
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Unit]
Description=Firmenverzeichnis monthly SLA report (STANDBY)
OnFailure=firmen-alert@%n.service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=firmen
Group=firmen
WorkingDirectory=/srv/firmen/app
ExecStart=/srv/firmen/app/.venv/bin/python -m ops.sla_report
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/firmen
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
